# EMS backend environment variables.
# Copy to .env (gitignored) and adjust. Spring Boot does not read .env itself:
# docker compose loads it via env_file, or export it in your shell / IDE run config.
# Values shown are the local defaults unless marked REQUIRED.

# ── Runtime ───────────────────────────────────────────────────────────────────
# Profile: dev (GraphiQL, introspection, DEBUG app logs) | prod (hardened). No profile = base config.
SPRING_PROFILES_ACTIVE=dev
# HTTP port (most PaaS hosts inject PORT).
PORT=8080
# Extra JVM flags (container image only).
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/ems
DB_USERNAME=ems
# REQUIRED (no default).
DB_PASSWORD=ems

# ── JWT signing keys ──────────────────────────────────────────────────────────
# Generate with: scripts/generate-jwt-keys.sh   (writes ./.keys/, never commit them)
# Paths are relative to the backend working directory, or absolute (e.g. /run/keys/... in a container).
JWT_PRIVATE_KEY_PATH=./.keys/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=./.keys/jwt-public-key.pem
# Alternative for hosts with secret env vars: the full PEM content, real line breaks included
# (takes precedence over *_PATH). Set these in the host's secret store rather than in this file.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# Access token lifetime (ms), default 15 min.
JWT_EXPIRATION_MS=900000
# Refresh session lifetime (ms), default 7d; renewed on every refresh.
JWT_REFRESH_EXPIRATION_MS=604800000
# Issuer and audience written to and required on every access token.
JWT_ISSUER=ems-api
JWT_AUDIENCE=ems-web

# ── Auth policy ───────────────────────────────────────────────────────────────
# Transition flag: also emit the legacy `permissions` / `account_id` claims for the current frontend.
# Authorization never reads them. Set to false once the frontend uses the `me` query.
AUTH_LEGACY_PERMISSIONS_CLAIM=true
# How long a resolved principal (status + permissions) is cached; evicted on changes.
AUTH_PRINCIPAL_CACHE_TTL=60s
# Lock an account for AUTH_LOCKOUT_DURATION after this many consecutive wrong passwords.
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m
# Per-IP limit on /login and /set-password: CAPACITY requests per PERIOD (429 + Retry-After).
AUTH_RATE_LIMIT_CAPACITY=10
AUTH_RATE_LIMIT_PERIOD=1m
# Lifetime of one-time links (welcome / set-password, password reset).
AUTH_WELCOME_TOKEN_TTL=72h
AUTH_PASSWORD_RESET_TOKEN_TTL=1h

# ── Seeded administrator (created on first startup if missing) ────────────────
ADMIN_EMAIL=admin@ems.local
# REQUIRED to seed the admin: startup fails with a clear message if it is unset when seeding is needed.
ADMIN_PASSWORD=change-me

# ── Web app / CORS ────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call the API with credentials (no wildcards).
ALLOWED_ORIGINS=http://localhost:4200
# Base URL of the web app; welcome emails link to ${APP_FRONTEND_URL}/set-password?token=...
APP_FRONTEND_URL=http://localhost:4200

# ── Refresh-token cookie ──────────────────────────────────────────────────────
# true behind HTTPS (the prod profile defaults to true).
AUTH_COOKIE_SECURE=false
# Lax when app and API share a site (app.<domain> / api.<domain>); None (+ Secure) across sites.
AUTH_COOKIE_SAMESITE=Lax
# Must cover the auth endpoints, which live under /api/v1/auth.
AUTH_COOKIE_PATH=/api/v1/auth

# ── Mail (defaults target a local Mailpit: SMTP :1025, UI http://localhost:8025) ─
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ems.local
# Real SMTP providers usually need both set to true (and MAIL_PORT=587).
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
