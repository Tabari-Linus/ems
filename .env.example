SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/mydb
DB_USERNAME=myuser
DB_PASSWORD=mypassword
HIBERNATE_DDL_AUTO=create-drop

ALLOWED_CORS_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# RSA-2048 key pair — reference classpath PEM files (dev) or use inline PEM strings (prod/CI).
# To generate a new key pair:
#   openssl genrsa -out private_raw.pem 2048
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in private_raw.pem -out jwt-private-key.pem
#   openssl rsa -in private_raw.pem -pubout -out jwt-public-key.pem
# Place the files in src/main/resources/certificates/ for local dev.
JWT_PUBLIC_KEY=classpath:certificates/jwt-public-key.pem
JWT_PRIVATE_KEY=classpath:certificates/jwt-private-key.pem
JWT_EXPIRATION_MS=28800000

# Admin account seeded on first startup — change before deploying
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-before-production
