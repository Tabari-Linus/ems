{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ui",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "input": "styles",
      "glob": "**/*.css",
      "output": "styles"
    }
  ],
  "allowedNonPeerDependencies": [
    "@fontsource-variable/geist-mono",
    "@fontsource-variable/plus-jakarta-sans"
  ]
}
