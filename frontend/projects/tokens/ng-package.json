{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/tokens",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    { "input": "src/generated", "glob": "tokens.css", "output": "css" },
    { "input": "src/generated", "glob": "tokens.json", "output": "." },
    { "input": "tokens", "glob": "**/*.json", "output": "dtcg" }
  ]
}
