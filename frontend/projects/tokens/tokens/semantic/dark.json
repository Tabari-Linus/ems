{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.neutral.950}",
        "$description": "Page background."
      },
      "surface": {
        "$value": "{color.neutral.900}",
        "$description": "Cards, panels, inputs."
      },
      "subtle": {
        "$value": "{color.neutral.850}",
        "$description": "Hover / zebra rows."
      },
      "muted": {
        "$value": "{color.neutral.800}",
        "$description": "Pressed / selected."
      },
      "inverse": {
        "$value": "{color.neutral.100}",
        "$description": "Tooltips, toasts."
      }
    },
    "text": {
      "default": {
        "$value": "{color.neutral.50}"
      },
      "muted": {
        "$value": "{color.neutral.400}"
      },
      "disabled": {
        "$value": "{color.neutral.600}",
        "$description": "Exempt from contrast (WCAG 1.4.3 inactive UI)."
      },
      "inverse": {
        "$value": "{color.neutral.950}"
      },
      "on-accent": {
        "$value": "{color.neutral.950}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.neutral.800}",
        "$description": "Decorative dividers; not a contrast-bearing boundary."
      },
      "strong": {
        "$value": "{color.neutral.500}",
        "$description": "Control boundaries (inputs, secondary buttons): >= 3:1."
      },
      "focus": {
        "$value": "{color.accent.400}",
        "$description": "Focus ring: >= 3:1."
      }
    },
    "accent": {
      "bg": {
        "$value": "{color.accent.400}"
      },
      "bg-hover": {
        "$value": "{color.accent.300}"
      },
      "subtle": {
        "$value": "{color.accent.950}"
      },
      "text": {
        "$value": "{color.accent.300}"
      },
      "border": {
        "$value": "{color.accent.500}"
      }
    },
    "status": {
      "success": {
        "text": {
          "$value": "{color.green.300}"
        },
        "bg": {
          "$value": "{color.green.950}"
        },
        "border": {
          "$value": "{color.green.500}"
        },
        "solid": {
          "$value": "{color.green.400}"
        },
        "solid-hover": {
          "$value": "{color.green.300}"
        },
        "on-solid": {
          "$value": "{color.neutral.950}"
        }
      },
      "warning": {
        "text": {
          "$value": "{color.amber.300}"
        },
        "bg": {
          "$value": "{color.amber.950}"
        },
        "border": {
          "$value": "{color.amber.500}"
        },
        "solid": {
          "$value": "{color.amber.400}"
        },
        "solid-hover": {
          "$value": "{color.amber.300}"
        },
        "on-solid": {
          "$value": "{color.neutral.950}"
        }
      },
      "danger": {
        "text": {
          "$value": "{color.red.300}"
        },
        "bg": {
          "$value": "{color.red.950}"
        },
        "border": {
          "$value": "{color.red.500}"
        },
        "solid": {
          "$value": "{color.red.400}"
        },
        "solid-hover": {
          "$value": "{color.red.300}"
        },
        "on-solid": {
          "$value": "{color.neutral.950}"
        }
      },
      "info": {
        "text": {
          "$value": "{color.blue.300}"
        },
        "bg": {
          "$value": "{color.blue.950}"
        },
        "border": {
          "$value": "{color.blue.500}"
        },
        "solid": {
          "$value": "{color.blue.400}"
        },
        "solid-hover": {
          "$value": "{color.blue.300}"
        },
        "on-solid": {
          "$value": "{color.neutral.950}"
        }
      }
    }
  }
}
