{
  "font": {
    "size": {
      "$type": "dimension",
      "$description": "Type sizes, named by their px value at a 16px root.",
      "12": { "$value": { "value": 0.75, "unit": "rem" } },
      "13": { "$value": { "value": 0.8125, "unit": "rem" } },
      "14": { "$value": { "value": 0.875, "unit": "rem" } },
      "15": { "$value": { "value": 0.9375, "unit": "rem" } },
      "17": { "$value": { "value": 1.0625, "unit": "rem" } },
      "28": { "$value": { "value": 1.75, "unit": "rem" } },
      "46": { "$value": { "value": 2.875, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.05 },
      "snug": { "$value": 1.15 },
      "compact": { "$value": 1.2 },
      "heading": { "$value": 1.3 },
      "normal": { "$value": 1.4 },
      "relaxed": { "$value": 1.55 }
    },
    "tracking": {
      "$type": "dimension",
      "tightest": { "$value": { "value": -0.045, "unit": "em" } },
      "tighter": { "$value": { "value": -0.035, "unit": "em" } },
      "tight": { "$value": { "value": -0.01, "unit": "em" } },
      "normal": { "$value": { "value": 0, "unit": "em" } }
    }
  }
}
