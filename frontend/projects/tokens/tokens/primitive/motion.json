{
  "duration": {
    "$type": "duration",
    "$description": "PLACEHOLDER durations (spec: 150-250 ms).",
    "fast": { "$value": { "value": 150, "unit": "ms" } },
    "normal": { "$value": { "value": 200, "unit": "ms" } },
    "slow": { "$value": { "value": 250, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "PLACEHOLDER easing curves.",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "enter": { "$value": [0, 0, 0.2, 1] },
    "exit": { "$value": [0.4, 0, 1, 1] }
  }
}
