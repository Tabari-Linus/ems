{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "ems-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "projects/tokens/src/generated/tokens.css",
              "projects/ui/styles/index.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "24kB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ems-frontend:build:production"
            },
            "development": {
              "buildTarget": "ems-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "include": ["src/**/*.spec.ts"],
            "coverageInclude": ["src/**/*.ts"],
            "coverageExclude": ["src/main.ts", "src/app/graphql/generated.ts", "src/**/*.spec.ts"],
            "coverageReporters": ["text-summary", "html", "lcov", "json-summary"]
          },
          "configurations": {
            "ci": {
              "watch": false,
              "coverage": true,
              "progress": false
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "e2e/**/*.ts",
              "visual/**/*.ts",
              ".storybook/*.ts",
              "*.ts"
            ]
          }
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "projects/ui",
      "sourceRoot": "projects/ui",
      "prefix": "ui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ui/tsconfig.spec.json",
            "include": ["**/*.spec.ts"],
            "coverageInclude": ["projects/ui/**/*.ts"],
            "coverageExclude": [
              "**/*.spec.ts",
              "**/*.stories.ts",
              "**/public-api.ts",
              "projects/ui/patterns/**",
              "projects/ui/testing/**",
              "projects/ui/scripts/**"
            ],
            "coverageReporters": ["text", "text-summary", "html", "lcov", "json-summary"],
            "coverageThresholds": {
              "lines": 90,
              "statements": 90,
              "functions": 90,
              "branches": 85
            }
          },
          "configurations": {
            "ci": {
              "watch": false,
              "coverage": true,
              "progress": false
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/ui/**/*.ts", "projects/ui/**/*.html"],
            "eslintConfig": "projects/ui/eslint.config.js"
          }
        }
      }
    },
    "icons": {
      "projectType": "library",
      "root": "projects/icons",
      "sourceRoot": "projects/icons/src",
      "prefix": "ui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/icons/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/icons/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/icons/tsconfig.spec.json",
            "include": ["**/*.spec.ts"],
            "coverageInclude": ["projects/icons/**/*.ts"],
            "coverageExclude": ["**/*.spec.ts", "**/*.stories.ts", "**/public-api.ts"],
            "coverageReporters": ["text", "text-summary", "html", "lcov", "json-summary"],
            "coverageThresholds": {
              "lines": 90,
              "statements": 90,
              "functions": 90,
              "branches": 85
            }
          },
          "configurations": {
            "ci": {
              "watch": false,
              "coverage": true,
              "progress": false
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/icons/**/*.ts", "projects/icons/**/*.html"],
            "eslintConfig": "projects/icons/eslint.config.js"
          }
        }
      }
    },
    "tokens": {
      "projectType": "library",
      "root": "projects/tokens",
      "sourceRoot": "projects/tokens/src",
      "prefix": "ems",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/tokens/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/tokens/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/tokens/**/*.ts"],
            "eslintConfig": "projects/tokens/eslint.config.js"
          }
        }
      }
    }
  }
}
