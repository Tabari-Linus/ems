{
  "name": "ems-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/app/graphql/generated.ts",
    "lint": "ng lint",
    "test:ci": "ng test ems-frontend --configuration ci",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "node projects/tokens/scripts/build-tokens.mjs",
    "tokens:check": "npm run tokens:build && git diff --exit-code -- projects/tokens/src/generated",
    "tokens:check-contrast": "node projects/tokens/scripts/check-contrast.mjs",
    "ds:lint-css": "node projects/ui/scripts/lint-css.mjs",
    "lib:build": "npm run tokens:build && ng build tokens && ng build icons && ng build ui",
    "lib:test": "ng test ui --configuration ci && ng test icons --configuration ci",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:build": "storybook build -c .storybook -o storybook-static",
    "storybook:test": "vitest run --config vitest.storybook.config.mts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "private": true,
  "workspaces": [
    "projects/tokens",
    "projects/icons",
    "projects/ui"
  ],
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@apollo/client": "^4.3.5",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@lucide/angular": "^1.61.0",
    "apollo-angular": "^14.2.0",
    "graphql": "^16.14.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/add": "^7.1.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript-apollo-angular": "^5.0.1",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/angular-vite": "^10.6.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "21.4.0",
    "culori": "^4.0.2",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "~21.2.7",
    "prettier": "^3.8.1",
    "storybook": "^10.6.3",
    "style-dictionary": "^5.7.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vite": "^8.3.5",
    "vitest": "^4.0.8"
  }
}
